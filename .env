# Sahaayak AI Configuration
ENVIRONMENT=development
PROJECT_NAME="Sahaayak AI"
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./sahaayak.db
SECRET_KEY=sahaayak_super_secret_hackathon_key_2026

# Google Gemini AI Provider
# If GEMINI_API_KEY is not set or empty, the application uses the deterministic demo adapter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Uploads directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
