# ==============================================================================
# Sahaayak AI Environment Configuration (Placeholders Only - Never commit secrets)
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="Sahaayak AI"
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL in production; SQLite local fallback)
DATABASE_URL=sqlite:///./sahaayak.db

# JWT Secret Key (Minimum 32 characters)
SECRET_KEY=replace_with_a_secure_random_jwt_signing_secret_here

# CORS Origins (JSON array of allowed frontends)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# AI Engine Settings (Google Gemini)
AI_MODE=demo
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Uploads & Retention
MAX_UPLOAD_MB=10
RETENTION_DAYS=30
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# Live Official Sources (NDMA SACHET / IMD)
LIVE_SOURCES_ENABLED=false
SACHET_FEED_URLS=["https://sachet.ndma.gov.in/feed/cap_rss"]
IMD_API_BASE_URL=https://api.imd.gov.in/v1
IMD_API_KEY=your_imd_api_key_here
LIVE_REFRESH_MINUTES=15
LIVE_HTTP_TIMEOUT_SECONDS=10.0
LIVE_MAX_PAYLOAD_KB=512
LIVE_DATA_FALLBACK=off
